# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
credentials.json
service-account*.json

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- node ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- deploy ---
.vercel/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- generated simulator databases ---
# Rebuilt from scratch on every run, so there is nothing in them worth keeping.
# `upi_sim.db` was committed before this rule existed and is still tracked; run
# `git rm --cached upi_sim.db` if you want it to stop showing up as modified.
bench.db*
console.db*
*.db-wal
*.db-shm

# --- logs & scratch ---
*.log
scratch/
tmp/

# python bytecode
__pycache__/
*.pyc
