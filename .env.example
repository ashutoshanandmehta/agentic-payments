# Copy to .env and fill in, or just export these in your shell.

# Needed only for the LLM planner. Without it the agent falls back to the
# deterministic RulePlanner and every other part of the simulator works
# unchanged -- including the full test suite.
#
# The SDK also accepts ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile
# under ~/.config/anthropic, so this is not the only way to authenticate.
ANTHROPIC_API_KEY=

# Where the SQLite database lives. Deleted and recreated by `--fresh`.
UPI_SIM_DB=upi_sim.db
